(
  $old := rows.prior;
  {
    "decision": "effective",
    "facts": [],
    "tables": {"daily_review": {"upsert": [{
      "day_utc": event.day_utc,
      "harness": event.harness,
      "record_count": ($old ? $old.record_count : 0) + 1,
      "log_count": ($old ? $old.log_count : 0) + (event.signal = "log" ? 1 : 0),
      "span_count": ($old ? $old.span_count : 0) + (event.signal = "span" ? 1 : 0),
      "metric_count": ($old ? $old.metric_count : 0) + (event.signal = "metric" ? 1 : 0),
      "tool_event_count": ($old ? $old.tool_event_count : 0) + event.tool_event,
      "api_event_count": ($old ? $old.api_event_count : 0) + event.api_event,
      "success_count": ($old ? $old.success_count : 0) + (event.success_state = "success" ? 1 : 0),
      "failure_count": ($old ? $old.failure_count : 0) + (event.success_state = "failure" ? 1 : 0),
      "outcome_unknown_count": ($old ? $old.outcome_unknown_count : 0) + (event.success_state = "unknown" ? 1 : 0),
      "duration_observed_count": ($old ? $old.duration_observed_count : 0) + event.duration_observed,
      "duration_milliseconds_total": ($old ? $old.duration_milliseconds_total : 0) + event.duration_milliseconds,
      "duration_gt_5000ms_count": ($old ? $old.duration_gt_5000ms_count : 0) +
        (event.duration_observed = 1 and event.duration_milliseconds > 5000 ? 1 : 0),
      "input_tokens": ($old ? $old.input_tokens : 0) + event.input_tokens,
      "cached_input_tokens": ($old ? $old.cached_input_tokens : 0) + event.cached_input_tokens,
      "output_tokens": ($old ? $old.output_tokens : 0) + event.output_tokens,
      "reasoning_output_tokens": ($old ? $old.reasoning_output_tokens : 0) + event.reasoning_output_tokens,
      "cost_microusd": ($old ? $old.cost_microusd : 0) + event.cost_microusd,
      "session_unknown_count": ($old ? $old.session_unknown_count : 0) + event.session_unknown,
      "identity_metadata_count": ($old ? $old.identity_metadata_count : 0) + event.identity_metadata,
      "auth_metadata_count": ($old ? $old.auth_metadata_count : 0) + event.auth_metadata,
      "raw_prompt_content_count": ($old ? $old.raw_prompt_content_count : 0) + event.raw_prompt_content,
      "raw_tool_content_count": ($old ? $old.raw_tool_content_count : 0) + event.raw_tool_content,
      "risky_action_count": ($old ? $old.risky_action_count : 0) + event.risky_action,
      "first_event_time_unix_nano": $old ? $old.first_event_time_unix_nano : event.event_time_unix_nano,
      "last_event_time_unix_nano": event.event_time_unix_nano,
      "last_source_position": event.source_position
    }]}}
  }
)
