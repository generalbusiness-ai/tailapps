(
  $old := rows.prior;
	$tool_coverage_old := rows.tool_coverage_prior;
	$target_coverage_old := rows.target_coverage_prior;
	$progress_coverage_old := rows.progress_coverage_prior;
	$action_same := $old and $old.action_fingerprint = event.action_fingerprint;
	$repeat := $action_same ? $old.repeat_count + 1 : 1;
  $failed := event.success = false;

  $success_observed := event.success = true or event.success = false;
	$progress_observed := event.progress_coverage = "observed";
	$progress_same := $progress_observed and $old and $old.progress_fingerprint = event.progress_fingerprint;
	$no_progress := $not($progress_observed) ? ($old ? $old.no_progress_count : 0) : ($progress_same ? $old.no_progress_count + 1 : 0);
	$failures := $not($success_observed) ? ($old ? $old.consecutive_failures : 0) : ($failed ? ($old ? $old.consecutive_failures + 1 : 1) : 0);
  $total := $old ? $old.total_actions + 1 : 1;
  $first := $old ? $old.first_activity_unix_nano : event.event_time_unix_nano;
	$distinct := $not($progress_observed) ? ($old ? $old.last_distinct_progress_unix_nano : event.event_time_unix_nano) : ($progress_same ? $old.last_distinct_progress_unix_nano : event.event_time_unix_nano);

  $denied_tool := event.tool = "dangerous_shell" or event.tool = "external_network";
  $denied_operation := event.operation_kind = "destructive" or event.operation_kind = "network_external";
  $outside_target := event.target_coverage = "observed" and $substring(event.target, 0, 9) = "/outside/";
  $unknown := event.tool_coverage != "observed" or event.target_coverage != "observed";
	$action_fingerprint_coverage := $unknown ? "degraded" : "observed";
  $rule := $denied_tool ? "denied-tool" : ($denied_operation ? "denied-operation" : ($outside_target ? "target-boundary" : ($unknown ? "insufficient-telemetry" : "")));
  $severity := $unknown and $rule = "insufficient-telemetry" ? "unknown" : "high";
  $summary := $rule = "denied-tool" ? "Observed a denied tool" :
    ($rule = "denied-operation" ? "Observed a denied operation kind" :
    ($rule = "target-boundary" ? "Observed an out-of-bound target" :
    ($rule = "insufficient-telemetry" ? "Required policy telemetry was absent or redacted" : "")));
  $policy_rows := $rule != "" ? [{
    "finding_id": $rule = "insufficient-telemetry" ?
      "policy|insufficient-telemetry|" & event.harness & "|" & event.session_id :
      "policy|" & event.harness & "|" & event.session_id & "|" & $string(event.source_position),
    "rule_id": $rule,
    "severity": $severity,
    "harness": event.harness,
    "session_id": event.session_id,
    "source_position": event.source_position,
    "observed_unix_nano": event.event_time_unix_nano,
    "summary": $summary,
    "evidence": {
      "tool": event.tool,
      "operation_kind": event.operation_kind,
      "target": event.target,
      "argument_digest": event.argument_digest,
      "coverage_reason": event.coverage_reason
    },
    "coverage_state": $unknown ? "unknown" : "observed"
  }] : [];

  $loop_kind := $failures >= 3 ? "repeated-failure" : ($repeat >= 3 ? "repeated-action" : ($no_progress >= 3 ? "bounded-no-progress" : ""));
  $loop_rows := $loop_kind != "" ? [{
    "finding_id": "loop|" & $loop_kind & "|" & event.harness & "|" & event.session_id,
    "finding_kind": $loop_kind,
    "harness": event.harness,
    "session_id": event.session_id,
    "source_position": event.source_position,
    "first_observed_unix_nano": $first,
    "last_observed_unix_nano": event.event_time_unix_nano,
    "repeat_count": $repeat,
    "consecutive_failures": $failures,
    "no_progress_count": $no_progress,
    "evidence": {
	  "action_fingerprint": event.action_fingerprint,
	  "action_fingerprint_coverage": $action_fingerprint_coverage,
	  "action_fingerprint_reason": event.coverage_reason,
	  "progress_fingerprint": event.progress_fingerprint,
	  "progress_coverage": event.progress_coverage,
      "last_distinct_progress_unix_nano": $distinct
    }
  }] : [];
  $failure_rows := $failed ? [{
    "source_position": event.source_position,
    "event_time_unix_nano": event.event_time_unix_nano,
    "harness": event.harness,
    "session_id": event.session_id,
    "session_id_prefix": event.session_id_prefix,
    "project": event.project,
    "model": event.model,
    "tool": event.tool ? event.tool : "unknown",
    "command": event.command,
    "tool_arguments": event.tool_arguments,
    "target": event.target ? event.target : "",
    "failure_detail": event.failure_detail,
    "detail_coverage": event.command != "" and event.failure_detail != "" ? "observed" :
      ((event.command != "" or event.tool_arguments != "" or event.failure_detail != "" or event.target) ? "partial" : "unknown")
  }] : [];

  {
    "decision": "effective",
    "facts": [],
    "tables": {
      "telemetry_coverage": {"upsert": [
        {
          "harness": event.harness,
          "capability": event.tool_capability,
          "state": event.tool_coverage,
          "reason": event.tool_coverage_reason,
          "first_seen_unix_nano": $tool_coverage_old ? $tool_coverage_old.first_seen_unix_nano : event.event_time_unix_nano,
          "last_seen_unix_nano": event.event_time_unix_nano,
          "last_source_position": event.source_position
        },
        {
          "harness": event.harness,
          "capability": event.target_capability,
          "state": event.target_coverage,
          "reason": event.target_coverage_reason,
          "first_seen_unix_nano": $target_coverage_old ? $target_coverage_old.first_seen_unix_nano : event.event_time_unix_nano,
          "last_seen_unix_nano": event.event_time_unix_nano,
          "last_source_position": event.source_position
        },
        {
          "harness": event.harness,
          "capability": event.progress_capability,
          "state": event.progress_coverage,
          "reason": event.progress_coverage_reason,
          "first_seen_unix_nano": $progress_coverage_old ? $progress_coverage_old.first_seen_unix_nano : event.event_time_unix_nano,
          "last_seen_unix_nano": event.event_time_unix_nano,
          "last_source_position": event.source_position
        }
      ]},
      "session_progress": {"upsert": [{
        "harness": event.harness,
        "session_id": event.session_id,
        "first_activity_unix_nano": $first,
        "last_activity_unix_nano": event.event_time_unix_nano,
        "last_distinct_progress_unix_nano": $distinct,
		"action_fingerprint": event.action_fingerprint,
		"progress_fingerprint": event.progress_fingerprint,
        "repeat_count": $repeat,
        "no_progress_count": $no_progress,
        "consecutive_failures": $failures,
        "total_actions": $total,
        "last_source_position": event.source_position
      }]},
      "policy_findings": {"upsert": $policy_rows},
      "loop_findings": {"upsert": $loop_rows},
      "tool_failure_detail": {"upsert": $failure_rows}
    }
  }
)
