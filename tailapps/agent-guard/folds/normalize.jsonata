(
  $attrs := event.record.attributes ? event.record.attributes : {};
  $resource := event.record.resource.attributes ? event.record.resource.attributes : {};
  $semantic_name_raw := $lookup($attrs, "event.name");
  $event_name := $exists($semantic_name_raw) and $string($semantic_name_raw) != "" ? $string($semantic_name_raw) : event.name;
  $harness := event.source = "codex_cli_rs" ? "codex" : event.source;
  $event_time := event.time_unix_nano ? event.time_unix_nano :
    (event.observed_unix_nano ? event.observed_unix_nano : null);
  $claude := $event_name = "claude_code.tool_result" or $event_name = "claude_code.tool_decision";
  $codex := $event_name = "codex.tool_result" or $event_name = "codex.tool_decision" or $event_name = "codex.tool_call";
  $opencode := $event_name = "opencode.tool.execute.after" or $event_name = "opencode.tool.execute.before";
  $recognized := ($claude or $codex or $opencode) and $event_time;
  $session_raw := $lookup($attrs, "session.id") ? $lookup($attrs, "session.id") :
    ($lookup($attrs, "conversation.id") ? $lookup($attrs, "conversation.id") :
    ($lookup($attrs, "session_id") ? $lookup($attrs, "session_id") : $lookup($resource, "service.instance.id")));
  $session_known := $exists($session_raw) and $string($session_raw) != "";
  $session := $session_known ? $string($session_raw) : "unknown:" & $harness;
  $tool_raw := $lookup($attrs, "tool_name") ? $lookup($attrs, "tool_name") : $lookup($attrs, "tool");
  $tool_known := $exists($tool_raw) and $string($tool_raw) != "";
  $tool := $tool_known ? $lowercase($string($tool_raw)) : null;
  $target_raw := $lookup($attrs, "target") ? $lookup($attrs, "target") :
    ($lookup($attrs, "file_path") ? $lookup($attrs, "file_path") : $lookup($attrs, "full_command"));
  $target_known := $exists($target_raw) and $string($target_raw) != "" and $string($target_raw) != "<redacted>";
  $target := $target_known ? $string($target_raw) : null;
  $success_raw := $lookup($attrs, "success");
  $success_known := $exists($success_raw);
  $success := $success_known ? ($success_raw = true or $string($success_raw) = "true") : null;
  $argument_digest_raw := $lookup($attrs, "argument_digest");
  $argument_digest := $exists($argument_digest_raw) ? $string($argument_digest_raw) : event.content_digest;
  $operation := $lookup($attrs, "operation_kind") ? $string($lookup($attrs, "operation_kind")) : "tool";
	$progress_raw := $lookup($attrs, "progress_fingerprint");
	$progress_known := $exists($progress_raw) and $string($progress_raw) != "" and $string($progress_raw) != "<redacted>";
  $tool_coverage := $session_known and $tool_known ? "observed" : "unknown";
  $target_coverage := $target_known ? "observed" : "unknown";
  $reason := $not($session_known) ? "session identity absent" :
    ($not($tool_known) ? "tool identity absent" :
    ($not($target_known) ? "tool target absent, gated, or redacted" : "required fields observed"));
	$action_fingerprint := $harness & "|" & $session & "|" & $operation & "|" & ($tool_known ? $tool : "unknown") & "|" & ($target_known ? $target : "unknown");
	$progress_fingerprint := $progress_known ? $string($progress_raw) : "unknown";
  $recognized ? {
    "decision": "effective",
    "facts": [],
    "events": {
      "otel_event": [{
        "harness": $harness,
        "session_id": $session,
        "kind": "tool-activity",
        "operation_kind": $operation,
        "tool": $tool,
        "target": $target,
        "argument_digest": $argument_digest,
        "success": $success,
        "event_time_unix_nano": $string($event_time),
		"action_fingerprint": $action_fingerprint,
		"progress_fingerprint": $progress_fingerprint,
		"progress_coverage": $progress_known ? "observed" : "unknown",
        "source_position": meta.position,
        "tool_coverage": $tool_coverage,
        "target_coverage": $target_coverage,
        "coverage_reason": $reason
      }]
    },
    "tables": {
      "telemetry_coverage": {"upsert": [
        {
          "harness": $harness,
          "capability": "tool-observation",
          "state": $tool_coverage,
          "reason": $reason,
          "last_source_position": meta.position
        },
        {
          "harness": $harness,
          "capability": "target-detail",
          "state": $target_coverage,
          "reason": $reason,
          "last_source_position": meta.position
		},
		{
		  "harness": $harness,
		  "capability": "progress-detail",
		  "state": $progress_known ? "observed" : "unknown",
		  "reason": $progress_known ? "progress fingerprint observed" : "progress fingerprint absent, gated, or redacted",
		  "last_source_position": meta.position
        }
      ]}
    }
  } : {
    "decision": "ineffective",
    "facts": [],
    "events": {},
    "tables": {}
  }
)
