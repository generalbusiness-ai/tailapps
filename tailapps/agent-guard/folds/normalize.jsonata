(
  $attrs := event.record.attributes ? event.record.attributes : {};
  $resource := event.record.resource.attributes ? event.record.resource.attributes : {};
  $semantic_name_raw := $lookup($attrs, "event.name");
  $body_name := $exists(event.record.body) ? $string(event.record.body) : "";
  $claude_body_name := event.source = "claude-code" and $substring($body_name, 0, 12) = "claude_code.";
  $event_name := $claude_body_name ? $body_name :
    ($exists($semantic_name_raw) and $string($semantic_name_raw) != "" ? $string($semantic_name_raw) : event.name);
  $harness := (event.source = "codex_cli_rs" or event.source = "codex_exec" or
    event.source = "codex-app-server") ? "codex" :
    ((event.source = "copilot-chat" or event.source = "vscode-copilot-chat") ? "vscode-copilot-chat" : event.source);
  $opencode_log := $harness = "opencode" and event.signal = "log";
  $vscode_log := $harness = "vscode-copilot-chat" and event.signal = "log";
  $event_time := event.time_unix_nano ? event.time_unix_nano :
    (event.observed_unix_nano ? event.observed_unix_nano : null);
  $claude := $event_name = "claude_code.tool_result" or $event_name = "claude_code.tool_decision";
  $codex := $event_name = "codex.tool_result" or $event_name = "codex.tool_decision" or $event_name = "codex.tool_call";
  $opencode := $event_name = "opencode.tool.execute.after" or $event_name = "opencode.tool.execute.before" or
    ($opencode_log and $event_name = "tool_result");
  $vscode := $vscode_log and $event_name = "copilot_chat.tool.call";
  $recognized := ($claude or $codex or $opencode or $vscode) and $event_time;
  $session_raw := $lookup($attrs, "gen_ai.conversation.id") ? $lookup($attrs, "gen_ai.conversation.id") :
    ($lookup($attrs, "session.id") ? $lookup($attrs, "session.id") :
    ($lookup($attrs, "conversation.id") ? $lookup($attrs, "conversation.id") :
    ($lookup($attrs, "session_id") ? $lookup($attrs, "session_id") :
    ($lookup($resource, "session.id") ? $lookup($resource, "session.id") : $lookup($resource, "service.instance.id")))));
  $session_known := $exists($session_raw) and $session_raw != "";
  $session := $session_known ? $string($session_raw) : "unknown:" & $harness;
  $project_raw := $exists($lookup($attrs, "project")) ? $lookup($attrs, "project") :
    ($exists($lookup($attrs, "project.name")) ? $lookup($attrs, "project.name") :
    ($exists($lookup($attrs, "project_path")) ? $lookup($attrs, "project_path") :
    ($exists($lookup($attrs, "cwd")) ? $lookup($attrs, "cwd") :
    ($exists($lookup($attrs, "working_directory")) ? $lookup($attrs, "working_directory") :
      $lookup($attrs, "workspace.root")))));
  $model_raw := $exists($lookup($attrs, "model")) ? $lookup($attrs, "model") :
    ($exists($lookup($attrs, "gen_ai.request.model")) ? $lookup($attrs, "gen_ai.request.model") :
    ($exists($lookup($attrs, "gen_ai.response.model")) ? $lookup($attrs, "gen_ai.response.model") :
      $lookup($attrs, "model_name")));
  $tool_raw := $lookup($attrs, "tool_name") ? $lookup($attrs, "tool_name") :
    ($lookup($attrs, "tool") ? $lookup($attrs, "tool") : $lookup($attrs, "gen_ai.tool.name"));
  $tool_known := $exists($tool_raw) and $string($tool_raw) != "";
  $tool := $tool_known ? $lowercase($string($tool_raw)) : null;
  $target_raw := $lookup($attrs, "target") ? $lookup($attrs, "target") :
    ($lookup($attrs, "file_path") ? $lookup($attrs, "file_path") :
    $lookup($attrs, "full_command"));
  $target_known := $exists($target_raw) and $string($target_raw) != "" and $string($target_raw) != "<redacted>";
  $target := $target_known ? $string($target_raw) : null;
  $success_raw := $exists($lookup($attrs, "success")) ? $lookup($attrs, "success") :
    $lookup($attrs, "tool.success");
  $success_known := $exists($success_raw);
  $success := $success_known ? ($success_raw = true or $string($success_raw) = "true") : null;
  $argument_digest_raw := $lookup($attrs, "argument_digest");
  $argument_digest := $exists($argument_digest_raw) ? $string($argument_digest_raw) : event.content_digest;
  $arguments_raw := $exists($lookup($attrs, "arguments")) ? $lookup($attrs, "arguments") :
    ($exists($lookup($attrs, "tool_input")) ? $lookup($attrs, "tool_input") :
    ($exists($lookup($attrs, "tool_parameters")) ? $lookup($attrs, "tool_parameters") :
      $lookup($attrs, "tool_content")));
  $command_raw := $exists($lookup($attrs, "full_command")) ? $lookup($attrs, "full_command") :
    ($exists($lookup($attrs, "command")) ? $lookup($attrs, "command") : $lookup($attrs, "cmd"));
  $failure_raw := $exists($lookup($attrs, "error.message")) ? $lookup($attrs, "error.message") :
    ($exists($lookup($attrs, "error")) ? $lookup($attrs, "error") :
    ($exists($lookup($attrs, "failure_reason")) ? $lookup($attrs, "failure_reason") :
      $lookup($attrs, "message")));
  $operation := $lookup($attrs, "operation_kind") ? $string($lookup($attrs, "operation_kind")) : "tool";
	$progress_raw := $lookup($attrs, "progress_fingerprint");
	$progress_known := $exists($progress_raw) and $string($progress_raw) != "" and $string($progress_raw) != "<redacted>";
  $tool_coverage := $session_known and $tool_known ? "observed" : "unknown";
  $target_coverage := $target_known ? "observed" : "unknown";
	$tool_reason := $not($session_known) ? "session identity absent" :
		($tool_known ? "session and tool identity observed" : "tool identity absent, gated, or redacted");
	$target_reason := $target_known ? "tool target observed" : "tool target absent, gated, or redacted";
	$progress_reason := $progress_known ? "progress fingerprint observed" : "progress fingerprint absent, gated, or redacted";
	$coverage_reason := $tool_coverage != "observed" ? $tool_reason :
		($target_coverage != "observed" ? $target_reason : "required policy fields observed");
	$action_fingerprint := $harness & "|" & $session & "|" & $operation & "|" & ($tool_known ? $tool : "unknown") & "|" & ($target_known ? $target : "unknown");
	$progress_fingerprint := $progress_known ? $string($progress_raw) : "unknown";
  $recognized ? {
    "decision": "effective",
    "facts": [],
    "events": {
      "otel_event": [{
        "harness": $harness,
        "session_id": $session,
        "session_id_prefix": $substring($session, 0, 12),
        "project": $exists($project_raw) and $string($project_raw) != "" ? $substring($string($project_raw), 0, 4096) : "unknown",
        "model": $exists($model_raw) and $string($model_raw) != "" ? $substring($string($model_raw), 0, 1024) : "unknown",
        "kind": "tool-activity",
        "operation_kind": $operation,
        "tool": $tool,
        "target": $target,
        "command": $success = false and $exists($command_raw) ? $substring($string($command_raw), 0, 8192) : "",
        "tool_arguments": $success = false and $exists($arguments_raw) ? $substring($string($arguments_raw), 0, 8192) : "",
        "failure_detail": $success = false and $exists($failure_raw) ? $substring($string($failure_raw), 0, 8192) : "",
        "argument_digest": $argument_digest,
        "success": $success,
        "event_time_unix_nano": $string($event_time),
		"action_fingerprint": $action_fingerprint,
		"progress_fingerprint": $progress_fingerprint,
		"progress_coverage": $progress_known ? "observed" : "unknown",
        "source_position": meta.position,
        "tool_coverage": $tool_coverage,
        "target_coverage": $target_coverage,
        "coverage_reason": $coverage_reason,
        "tool_capability": "tool-observation",
        "target_capability": "target-detail",
        "progress_capability": "progress-detail",
        "tool_coverage_reason": $tool_reason,
        "target_coverage_reason": $target_reason,
        "progress_coverage_reason": $progress_reason
      }]
    },
    "tables": {}
  } : {
    "decision": "ineffective",
    "facts": [],
    "events": {},
    "tables": {}
  }
)
