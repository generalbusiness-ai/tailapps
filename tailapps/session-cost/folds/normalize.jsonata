(
  $attrs := event.record.attributes ? event.record.attributes : {};
  $resource := event.record.resource.attributes ? event.record.resource.attributes : {};
  $semantic_name_raw := $lookup($attrs, "event.name");
  $body_name := $exists(event.record.body) ? $string(event.record.body) : "";
  $claude_body_name := event.source = "claude-code" and $substring($body_name, 0, 12) = "claude_code.";
  $event_name := $claude_body_name ? $body_name :
    ($exists($semantic_name_raw) and $string($semantic_name_raw) != "" ? $string($semantic_name_raw) : event.name);
  $harness := (event.source = "codex_cli_rs" or event.source = "codex_exec" or
    event.source = "codex-app-server") ? "codex" :
    ((event.source = "copilot-chat" or event.source = "vscode-copilot-chat") ? "vscode-copilot-chat" : event.source);
  $opencode_log := $harness = "opencode" and event.signal = "log";
  $vscode_log := $harness = "vscode-copilot-chat" and event.signal = "log";
  $event_time := event.time_unix_nano ? event.time_unix_nano :
    (event.observed_unix_nano ? event.observed_unix_nano : null);
  $codex_stream := $event_name = "codex.sse_event" and (
    $exists($lookup($attrs, "input_token_count")) or
    $exists($lookup($attrs, "output_token_count")) or
    $exists($lookup($attrs, "cached_input_token_count")) or
    $exists($lookup($attrs, "reasoning_output_token_count"))
  );
  $counter_present :=
    $exists($lookup($attrs, "input_tokens")) or
    $exists($lookup($attrs, "input_token_count")) or
    $exists($lookup($attrs, "output_tokens")) or
    $exists($lookup($attrs, "output_token_count")) or
    $exists($lookup($attrs, "cached_input_tokens")) or
    $exists($lookup($attrs, "cache_read_tokens")) or
    $exists($lookup($attrs, "cached_input_token_count")) or
    $exists($lookup($attrs, "cached_token_count")) or
    $exists($lookup($attrs, "gen_ai.usage.input_tokens")) or
    $exists($lookup($attrs, "gen_ai.usage.output_tokens")) or
    $exists($lookup($attrs, "gen_ai.usage.cache_read.input_tokens")) or
    $exists($lookup($attrs, "reasoning_output_tokens")) or
    $exists($lookup($attrs, "reasoning_output_token_count")) or
    $exists($lookup($attrs, "reasoning_token_count")) or $exists($lookup($attrs, "reasoning_tokens")) or
    $exists($lookup($attrs, "cost_microusd")) or
    $exists($lookup($attrs, "cost_usd_micros")) or $exists($lookup($attrs, "cost_usd"));
  $usage := ($event_name = "claude_code.api_request" or $event_name = "codex.api_request" or
    $event_name = "opencode.api_request" or ($opencode_log and $event_name = "api_request") or
    ($vscode_log and $event_name = "gen_ai.client.inference.operation.details") or $codex_stream) and
    $counter_present and $event_time;
  $session_raw := $lookup($attrs, "gen_ai.conversation.id") ? $lookup($attrs, "gen_ai.conversation.id") :
    ($lookup($attrs, "session.id") ? $lookup($attrs, "session.id") :
    ($lookup($attrs, "conversation.id") ? $lookup($attrs, "conversation.id") :
    ($lookup($attrs, "session_id") ? $lookup($attrs, "session_id") :
    ($lookup($resource, "session.id") ? $lookup($resource, "session.id") : $lookup($resource, "service.instance.id")))));
  $session_known := $exists($session_raw) and $session_raw != "";
  $session := $session_known ? $string($session_raw) : "unknown:" & $harness;
  $model_raw := $exists($lookup($attrs, "model")) ? $lookup($attrs, "model") :
    ($exists($lookup($attrs, "gen_ai.request.model")) ? $lookup($attrs, "gen_ai.request.model") :
    ($exists($lookup($attrs, "gen_ai.response.model")) ? $lookup($attrs, "gen_ai.response.model") :
    ($exists($lookup($attrs, "request.model")) ? $lookup($attrs, "request.model") : $lookup($attrs, "model_name"))));
  $model_known := $exists($model_raw) and $string($model_raw) != "";
  $project_raw := $exists($lookup($attrs, "project")) ? $lookup($attrs, "project") :
    ($exists($lookup($attrs, "project.name")) ? $lookup($attrs, "project.name") :
    ($exists($lookup($attrs, "project_path")) ? $lookup($attrs, "project_path") :
    ($exists($lookup($attrs, "cwd")) ? $lookup($attrs, "cwd") :
    ($exists($lookup($attrs, "working_directory")) ? $lookup($attrs, "working_directory") :
      $lookup($attrs, "workspace.root")))));
  $project_known := $exists($project_raw) and $string($project_raw) != "";
  $input_raw := $exists($lookup($attrs, "input_tokens")) ? $lookup($attrs, "input_tokens") :
    ($exists($lookup($attrs, "input_token_count")) ? $lookup($attrs, "input_token_count") : $lookup($attrs, "gen_ai.usage.input_tokens"));
  $output_raw := $exists($lookup($attrs, "output_tokens")) ? $lookup($attrs, "output_tokens") :
    ($exists($lookup($attrs, "output_token_count")) ? $lookup($attrs, "output_token_count") : $lookup($attrs, "gen_ai.usage.output_tokens"));
  $cached_raw := $exists($lookup($attrs, "cached_input_tokens")) ? $lookup($attrs, "cached_input_tokens") :
    ($exists($lookup($attrs, "cache_read_tokens")) ? $lookup($attrs, "cache_read_tokens") :
    ($exists($lookup($attrs, "cached_input_token_count")) ? $lookup($attrs, "cached_input_token_count") :
    ($exists($lookup($attrs, "cached_token_count")) ? $lookup($attrs, "cached_token_count") : $lookup($attrs, "gen_ai.usage.cache_read.input_tokens"))));
  $reasoning_raw := $exists($lookup($attrs, "reasoning_output_tokens")) ? $lookup($attrs, "reasoning_output_tokens") :
    ($exists($lookup($attrs, "reasoning_output_token_count")) ? $lookup($attrs, "reasoning_output_token_count") :
    ($exists($lookup($attrs, "reasoning_token_count")) ? $lookup($attrs, "reasoning_token_count") : $lookup($attrs, "reasoning_tokens")));
  $input := $exists($input_raw) ? $number($input_raw) : 0;
  $output := $exists($output_raw) ? $number($output_raw) : 0;
  $cached := $exists($cached_raw) ? $number($cached_raw) : 0;
  $reasoning := $exists($reasoning_raw) ? $number($reasoning_raw) : 0;
  $cost_raw := $exists($lookup($attrs, "cost_microusd")) ? $lookup($attrs, "cost_microusd") : $lookup($attrs, "cost_usd_micros");
  $cost_usd_raw := $lookup($attrs, "cost_usd");
  $cost := $exists($cost_raw) ? $number($cost_raw) :
    (($opencode_log and $exists($cost_usd_raw)) ? $round($number($cost_usd_raw) / 0.000001) : 0);
  $usage ? {
    "decision": "effective",
    "facts": [],
    "events": {"otel_event": [{
      "harness": $harness,
      "session_id": $session,
      "session_id_prefix": $substring($session, 0, 12),
      "model": $model_known ? $string($model_raw) : "unknown",
      "project": $project_known ? $string($project_raw) : "unknown",
      "model_coverage": $model_known ? "observed" : "unknown",
      "project_coverage": $project_known ? "observed" : "unknown",
      "input_tokens": $input,
      "output_tokens": $output,
      "cached_input_tokens": $cached,
      "reasoning_output_tokens": $reasoning,
      "cost_microusd": $cost,
      "event_time_unix_nano": $string($event_time),
      "source_position": meta.position
    }]},
    "tables": {}
  } : {
    "decision": "ineffective",
    "facts": [],
    "events": {},
    "tables": {}
  }
)
