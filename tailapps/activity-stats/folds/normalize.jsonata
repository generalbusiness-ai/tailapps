(
  $attrs := event.record.attributes ? event.record.attributes : {};
  $resource := event.record.resource.attributes ? event.record.resource.attributes : {};
  $semantic_name_raw := $lookup($attrs, "event.name");
  $body_name := $exists(event.record.body) ? $string(event.record.body) : "";
  $claude_body_name := event.source = "claude-code" and $substring($body_name, 0, 12) = "claude_code.";
  $event_name := $claude_body_name ? $body_name :
    ($exists($semantic_name_raw) and $string($semantic_name_raw) != "" ? $string($semantic_name_raw) : event.name);
  $harness := (event.source = "codex_cli_rs" or event.source = "codex_exec") ? "codex" : event.source;
  $opencode_log := $harness = "opencode" and event.signal = "log";
  $event_time := event.time_unix_nano ? event.time_unix_nano :
    (event.observed_unix_nano ? event.observed_unix_nano : null);

  $counter_present :=
    $exists($lookup($attrs, "input_tokens")) or $exists($lookup($attrs, "input_token_count")) or
    $exists($lookup($attrs, "output_tokens")) or $exists($lookup($attrs, "output_token_count")) or
    $exists($lookup($attrs, "cached_input_tokens")) or $exists($lookup($attrs, "cache_read_tokens")) or
    $exists($lookup($attrs, "cached_input_token_count")) or $exists($lookup($attrs, "cached_token_count")) or
    $exists($lookup($attrs, "reasoning_output_tokens")) or $exists($lookup($attrs, "reasoning_output_token_count")) or
    $exists($lookup($attrs, "reasoning_token_count")) or $exists($lookup($attrs, "reasoning_tokens")) or
    $exists($lookup($attrs, "cost_microusd")) or $exists($lookup($attrs, "cost_usd_micros")) or
    $exists($lookup($attrs, "cost_usd"));
  $codex_usage := $event_name = "codex.sse_event" and $counter_present;
  $tool_event :=
    $event_name = "claude_code.tool_result" or $event_name = "claude_code.tool_decision" or
    $event_name = "codex.tool_result" or $event_name = "codex.tool_decision" or $event_name = "codex.tool_call" or
    $event_name = "opencode.tool.execute.after" or $event_name = "opencode.tool.execute.before" or
    ($opencode_log and $event_name = "tool_result");
  $api_request := $event_name = "claude_code.api_request" or $event_name = "codex.api_request" or
    $event_name = "opencode.api_request" or ($opencode_log and $event_name = "api_request");
  $assistant_response := $event_name = "claude_code.assistant_response" or $event_name = "codex.assistant_response" or $event_name = "opencode.assistant_response";
  $user_prompt := $event_name = "claude_code.user_prompt" or $event_name = "codex.user_prompt" or $event_name = "opencode.user_prompt";
  $turn_ttft := $event_name = "claude_code.turn_ttft" or $event_name = "codex.turn_ttft" or $event_name = "opencode.turn_ttft";
  $websocket := $event_name = "claude_code.websocket_request" or $event_name = "codex.websocket_request" or $event_name = "opencode.websocket_request";
  $family := $tool_event ? "tool" : ($api_request ? "api-request" : ($assistant_response ? "assistant-response" :
    ($user_prompt ? "user-prompt" : ($turn_ttft ? "turn-ttft" : ($websocket ? "websocket-request" :
    ($codex_usage ? "token-usage" : ""))))));
  $recognized := $family != "" and $event_time;

  $session_raw := $lookup($attrs, "session.id") ? $lookup($attrs, "session.id") :
    ($lookup($attrs, "conversation.id") ? $lookup($attrs, "conversation.id") :
    ($lookup($attrs, "session_id") ? $lookup($attrs, "session_id") : $lookup($resource, "service.instance.id")));
  $session_known := $exists($session_raw) and $string($session_raw) != "";
  $session := $session_known ? $string($session_raw) : "unknown:" & $harness;

  $tool_raw := $lookup($attrs, "tool_name") ? $lookup($attrs, "tool_name") : $lookup($attrs, "tool");
  $tool_name := $exists($tool_raw) ? $lowercase($string($tool_raw)) : "";
  $tool_bucket := $not($tool_event) ? "not-applicable" :
    (($tool_name = "exec_command" or $tool_name = "bash" or $tool_name = "shell" or $tool_name = "terminal") ? "shell" :
    (($tool_name = "read" or $tool_name = "write" or $tool_name = "edit") ? $tool_name :
    (($tool_name = "grep" or $tool_name = "search" or $tool_name = "find") ? "search" :
    ($tool_name = "" ? "unknown" : "other"))));

  $endpoint_raw := $lookup($attrs, "endpoint") ? $lookup($attrs, "endpoint") :
    ($lookup($attrs, "request.endpoint") ? $lookup($attrs, "request.endpoint") : $lookup($attrs, "url.path"));
  $endpoint_name := $exists($endpoint_raw) ? $lowercase($string($endpoint_raw)) : "";
  $endpoint_bucket := $not($api_request or $websocket) ? "not-applicable" :
    (($endpoint_name = "/v1/responses" or $endpoint_name = "responses") ? "responses" :
    (($endpoint_name = "/v1/chat/completions" or $endpoint_name = "chat/completions") ? "chat-completions" :
    ($websocket ? "websocket" : ($endpoint_name = "" ? "unknown" : "other"))));

  $length_raw := $lookup($attrs, "response_length") ? $lookup($attrs, "response_length") :
    ($lookup($attrs, "prompt_length") ? $lookup($attrs, "prompt_length") :
    ($lookup($attrs, "content_length") ? $lookup($attrs, "content_length") :
    ($lookup($attrs, "message_length") ? $lookup($attrs, "message_length") : $lookup($attrs, "body_length"))));
  $length_applicable := $assistant_response or $user_prompt;
  $length_known := $length_applicable and $exists($length_raw);
  $reported_length := $length_known ? $number($length_raw) : 0;
  $length_coverage := $not($length_applicable) ? "not-applicable" : ($length_known ? "observed" : "unknown");

  $duration_raw := $lookup($attrs, "duration_ms") ? $lookup($attrs, "duration_ms") :
    ($lookup($attrs, "latency_ms") ? $lookup($attrs, "latency_ms") :
    ($lookup($attrs, "request_latency_ms") ? $lookup($attrs, "request_latency_ms") :
    ($lookup($attrs, "ttft_ms") ? $lookup($attrs, "ttft_ms") : $lookup($attrs, "duration_milliseconds"))));
  $duration_applicable := $tool_event or $api_request or $turn_ttft or $websocket;
  $duration_known := $duration_applicable and $exists($duration_raw);
  $duration := $duration_known ? $number($duration_raw) : 0;
  $duration_coverage := $not($duration_applicable) ? "not-applicable" : ($duration_known ? "observed" : "unknown");

  $success_raw := $lookup($attrs, "success");
  $status_code_raw := $lookup($attrs, "status_code");
  $status_raw := $exists($status_code_raw) ? $status_code_raw : $lookup($attrs, "status");
  $status_text := $exists($status_raw) ? $lowercase($string($status_raw)) : "";
  $status_number := $exists($status_code_raw) ? $number($status_code_raw) : 0;
  $success_state := $exists($success_raw) ? (($success_raw = true or $string($success_raw) = "true") ? "success" : "failure") :
    (($status_text = "ok" or $status_text = "success" or $status_text = "completed" or ($status_number >= 200 and $status_number < 400)) ? "success" :
    (($status_text = "error" or $status_text = "failed" or $status_text = "failure" or $status_number >= 400) ? "failure" : "unknown"));

  $input_raw := $exists($lookup($attrs, "input_tokens")) ? $lookup($attrs, "input_tokens") : $lookup($attrs, "input_token_count");
  $output_raw := $exists($lookup($attrs, "output_tokens")) ? $lookup($attrs, "output_tokens") : $lookup($attrs, "output_token_count");
  $cached_raw := $exists($lookup($attrs, "cached_input_tokens")) ? $lookup($attrs, "cached_input_tokens") :
    ($exists($lookup($attrs, "cache_read_tokens")) ? $lookup($attrs, "cache_read_tokens") :
    ($exists($lookup($attrs, "cached_input_token_count")) ? $lookup($attrs, "cached_input_token_count") : $lookup($attrs, "cached_token_count")));
  $reasoning_raw := $exists($lookup($attrs, "reasoning_output_tokens")) ? $lookup($attrs, "reasoning_output_tokens") :
    ($exists($lookup($attrs, "reasoning_output_token_count")) ? $lookup($attrs, "reasoning_output_token_count") :
    ($exists($lookup($attrs, "reasoning_token_count")) ? $lookup($attrs, "reasoning_token_count") : $lookup($attrs, "reasoning_tokens")));
  $cost_raw := $exists($lookup($attrs, "cost_microusd")) ? $lookup($attrs, "cost_microusd") : $lookup($attrs, "cost_usd_micros");
  $cost_usd_raw := $lookup($attrs, "cost_usd");
  $cost_microusd := $exists($cost_raw) ? $number($cost_raw) :
    (($opencode_log and $exists($cost_usd_raw)) ? $round($number($cost_usd_raw) / 0.000001) : 0);
  $token_applicable := $api_request or $codex_usage;
  $token_coverage := $not($token_applicable) ? "not-applicable" : ($counter_present ? "observed" : "unknown");
  $performance := $api_request or $turn_ttft or $websocket;

  $activity := {
    "harness": $harness,
    "session_id": $session,
    "event_family": $family,
    "tool_bucket": $tool_bucket,
    "endpoint_bucket": $endpoint_bucket,
    "success_state": $success_state,
    "reported_length": $reported_length,
    "length_coverage": $length_coverage,
    "duration_milliseconds": $duration,
    "duration_coverage": $duration_coverage,
    "input_tokens": $exists($input_raw) ? $number($input_raw) : 0,
    "output_tokens": $exists($output_raw) ? $number($output_raw) : 0,
    "cached_input_tokens": $exists($cached_raw) ? $number($cached_raw) : 0,
    "reasoning_output_tokens": $exists($reasoning_raw) ? $number($reasoning_raw) : 0,
    "cost_microusd": $cost_microusd,
    "token_coverage": $token_coverage,
    "session_coverage": $session_known ? "observed" : "unknown",
    "performance_event": $performance,
    "event_time_unix_nano": $string($event_time),
    "source_position": meta.position
  };
  $recognized ? {
    "decision": "effective",
    "facts": [],
    "events": {
      "otel_event": [$activity]
    },
    "tables": {}
  } : {
    "decision": "ineffective",
    "facts": [],
    "events": {},
    "tables": {}
  }
)
